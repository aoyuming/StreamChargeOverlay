{
  "name": "sponsor-overlay-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "tsx src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "desktop:dev": "electron desktop/main.cjs",
    "package:server": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-server-package.ps1",
    "package:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-desktop.ps1",
    "package:webview2": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-webview2-desktop.ps1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "better-sqlite3": "^12.10.0",
    "express": "^5.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.22.4",
    "vite": "^7.2.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "electron": "^42.4.0",
    "electron-packager": "^17.1.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
